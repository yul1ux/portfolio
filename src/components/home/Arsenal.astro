---
import Icon from './Icon.astro';
import { skillCategories } from '../../data/portfolio';
---

<section id="arsenal" class="space-y-12">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-baseline font-mono-tech text-xs uppercase tracking-widest text-black/60 dark:text-white/50 border-b border-black/10 dark:border-white/10 pb-4">
    <h2 class="md:col-span-3">03 / ARSENAL</h2>
    <div class="md:col-span-9">TECHNICAL DOMAINS & TOOLING INDEX</div>
  </div>

  <div class="divide-y divide-black/10 dark:divide-white/10">
    {skillCategories.map((category) => (
      <div class="py-8 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start group hover:bg-black/[0.02] dark:hover:bg-white/[0.02] transition-colors">
        <div class="lg:col-span-4 flex items-center gap-3">
          <Icon name={category.icon} className="w-5 h-5 text-[#C45533]" />
          <h3 class="font-serif-editorial text-2xl">{category.title}</h3>
        </div>
        <div class="lg:col-span-5 text-sm text-black/70 dark:text-white/70 leading-relaxed">
          {category.description}
        </div>
        <div class="lg:col-span-3 flex flex-wrap gap-2 font-mono-tech text-[11px]">
          {category.skills.map((skill) => (
            <span class="px-2.5 py-1 bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
