---
import Icon from './Icon.astro';
import CopyEmailButton from '../interactive/CopyEmailButton';
---

<section
  id="contact"
  class="space-y-12 pt-12 border-t border-black/10 dark:border-white/10"
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-baseline font-mono-tech text-xs uppercase tracking-widest text-black/60 dark:text-white/50">
    <h2 class="md:col-span-3">CONTACT</h2>
    <div class="md:col-span-9">INITIATE COMMUNICATION</div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-end">
    <div class="lg:col-span-8 space-y-8">
      <h3 class="font-serif-editorial text-5xl sm:text-6xl md:text-7xl leading-tight">
        Let’s build something <br />
        <span class="italic font-light text-[#C45533]">reliable together.</span>
      </h3>

      <p class="text-base md:text-lg text-black/70 dark:text-white/70 max-w-xl font-light">
        I am interested in cloud infrastructure, automation, networking, and
        practical systems work. If you are building or improving infrastructure,
        I would be glad to connect.
      </p>

      <div class="p-6 border border-black/10 dark:border-white/10 bg-[#EFECE6] dark:bg-[#181816] inline-block w-full max-w-lg space-y-3">
        <div class="font-mono-tech text-xs text-black/60 dark:text-white/50">
          DIRECT EMAIL ADDRESS
        </div>
        <div class="flex items-center justify-between gap-4 font-mono-tech text-sm sm:text-base font-medium">
          <span class="truncate">soethiha5125@gmail.com</span>
          <CopyEmailButton client:visible />
        </div>
      </div>
    </div>

    <div class="lg:col-span-4 font-mono-tech text-xs space-y-4">
      <div class="text-black/60 dark:text-white/60 uppercase tracking-widest pb-2 border-b border-black/10 dark:border-white/10">
        CONNECTIVITY & LOGS
      </div>
      <ul class="space-y-3">
        <li>
          <a
            href="https://github.com/yul1ux"
            target="_blank"
            rel="noopener noreferrer"
            class="flex justify-between items-center accent-hover transition-colors py-1"
          >
            <span>GITHUB // @yul1ux</span>
            <Icon name="arrow-up-right" className="w-3.5 h-3.5" />
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>
