---
import { educationEntries } from '../../data/portfolio';
---

<section id="education" class="space-y-12">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-baseline font-mono-tech text-xs uppercase tracking-widest text-black/60 dark:text-white/50 border-b border-black/10 dark:border-white/10 pb-4">
    <h2 class="md:col-span-3">EDUCATION</h2>
    <div class="md:col-span-9">ACADEMIC TRAINING & QUALIFICATIONS</div>
  </div>

  <div class="space-y-6">
    {educationEntries.map((entry) => (
      <div class="border border-black/10 dark:border-white/10 bg-[#EFECE6]/70 dark:bg-[#181816]/80 p-6">
        <div class="font-mono-tech text-[11px] uppercase tracking-[0.18em] text-black/60 dark:text-white/50">
          {entry.start} — {entry.end ?? 'Present'}
        </div>
        <h3 class="mt-3 font-serif-editorial text-2xl md:text-3xl leading-tight">
          {entry.degree}
        </h3>
        <p class="mt-2 text-sm text-black/70 dark:text-white/70">
          {entry.school}
        </p>
      </div>
    ))}
  </div>
</section>
