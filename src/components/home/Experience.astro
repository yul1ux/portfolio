---
import { professionalExperience } from '../../data/portfolio';
---

<section id="log" class="space-y-12">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-baseline font-mono-tech text-xs uppercase tracking-widest text-black/60 dark:text-white/50 border-b border-black/10 dark:border-white/10 pb-4">
    <h2 class="md:col-span-3">LOGBOOK</h2>
    <div class="md:col-span-9">CHRONOLOGICAL RECORD & LEARNING</div>
  </div>

  <div class="relative pl-6 md:pl-8 border-l border-black/20 dark:border-white/20 space-y-12">
    {professionalExperience.map((entry) => (
      <div class="relative space-y-3">
        <span
          class={
            entry.emphasis === 'accent'
              ? 'absolute -left-[31px] md:-left-[39px] top-1.5 w-3 h-3 bg-[#C45533] rounded-full ring-4 ring-[#F5F4EF] dark:ring-[#121211]'
              : 'absolute -left-[31px] md:-left-[39px] top-1.5 w-3 h-3 bg-black/40 dark:bg-white/40 rounded-full ring-4 ring-[#F5F4EF] dark:ring-[#121211]'
          }
        />
        <div
          class={
            entry.emphasis === 'accent'
              ? 'font-mono-tech text-xs accent-copy font-semibold'
              : 'font-mono-tech text-xs text-black/60 dark:text-white/50'
          }
        >
          {entry.period}
        </div>
        <h3 class="font-serif-editorial text-2xl md:text-3xl">{entry.role}</h3>
        {entry.organization && (
          <p class="text-xs font-mono-tech text-black/60 dark:text-white/50">
            {entry.organization}
          </p>
        )}
        {entry.location && (
          <p class="text-xs font-mono-tech uppercase tracking-[0.16em] text-black/50 dark:text-white/50">
            {entry.location}
          </p>
        )}
        <p class="text-sm text-black/70 dark:text-white/70 max-w-3xl leading-relaxed">
          {entry.description}
        </p>
      </div>
    ))}
  </div>
</section>
