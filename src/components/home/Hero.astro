---
import Icon from './Icon.astro';
---

<section
  id="intro"
  class="min-h-[80vh] flex flex-col justify-between pt-8 pb-12 border-b border-black/10 dark:border-white/10 relative bg-grid-pattern"
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start font-mono-tech text-xs uppercase tracking-widest text-black/60 dark:text-white/50">
    <div class="md:col-span-3 flex items-center gap-2">
      <span class="accent-copy">01</span> / 06 â€” INDEX
    </div>
    <div class="md:col-span-5">
      LOCATION: 16Â°51'N 96Â°09'E â†’ DISTRIBUTED CLOUDS
    </div>
    <div class="md:col-span-4 text-right hidden md:block">
      AVAILABILITY: OPEN FOR ARCHITECTURE CONSULTING
    </div>
  </div>

  <div class="my-12 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    <div class="lg:col-span-7 space-y-6">
      <div class="inline-block px-3 py-1 bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 font-mono-tech text-xs tracking-wider">
        SYSTEMS & CLOUD ARCHITECT
      </div>

      <h1 class="font-serif-editorial text-6xl sm:text-7xl lg:text-8xl xl:text-9xl leading-[0.9] font-normal tracking-tight">
        Soe <br />
        <span class="italic font-light text-[#C45533]">Thiha.</span>
      </h1>

      <p class="text-lg md:text-xl font-light leading-relaxed max-w-xl text-black/80 dark:text-white/80">
        Architecting resilient cloud environments, deterministic pipelines, and
        self-healing infrastructure with quiet precision.
      </p>

      <div class="pt-4 flex flex-wrap items-center gap-4 font-mono-tech text-xs">
        <a
          href="#contact"
          class="px-6 py-3.5 bg-[#171717] dark:bg-[#E5E4DF] text-[#F5F4EF] dark:text-[#171717] font-medium tracking-wider uppercase hover:bg-[#B8472A] dark:hover:bg-[#B8472A] dark:hover:text-white transition-colors duration-300 flex items-center gap-2"
        >
          Initiate Dialogue <Icon name="arrow-up-right" className="w-4 h-4" />
        </a>
        <a
          href="#works"
          class="px-6 py-3.5 border border-black/20 dark:border-white/20 tracking-wider uppercase hover:border-[#C45533] dark:hover:border-[#C45533] transition-colors duration-300"
        >
          Selected Systems
        </a>
      </div>
    </div>

    <div class="lg:col-span-5 flex flex-col items-center justify-center">
      <div class="relative w-full max-w-md p-6 border border-black/10 dark:border-white/10 bg-[#EFECE6] dark:bg-[#181816] shadow-sm">
        <div class="absolute top-2 left-2 font-mono-tech text-[9px] text-black/60 dark:text-white/60">
          FIG 1.0 â€” THE WIZARD
        </div>
        <div class="absolute top-2 right-2 font-mono-tech text-[9px] text-black/60 dark:text-white/60">
          + ARCHITECT
        </div>

        <div class="w-full py-6 flex justify-center">
          <svg
            aria-hidden="true"
            focusable="false"
            viewBox="0 0 300 360"
            class="w-64 h-80 text-black dark:text-white transition-transform duration-700 hover:scale-105"
            fill="none"
            stroke="currentColor"
          >
            <circle
              cx="150"
              cy="160"
              r="110"
              stroke-dasharray="2 4"
              stroke-width="1"
              opacity="0.3"
            />
            <circle
              cx="150"
              cy="160"
              r="85"
              stroke-dasharray="1 6"
              stroke-width="1"
              opacity="0.2"
            />

            <path
              d="M150 25 L85 140 H215 Z"
              stroke-width="2.5"
              stroke-linejoin="round"
              fill="none"
            />
            <path
              d="M60 142 C 90 135, 210 135, 240 142 C 220 152, 80 152, 60 142 Z"
              stroke-width="2"
              fill="currentColor"
              fill-opacity="0.05"
            />

            <path
              d="M125 90 C 140 100, 160 85, 175 105"
              stroke-width="1.2"
              stroke-dasharray="3 2"
            />
            <path d="M110 120 C 135 125, 165 115, 190 125" stroke-width="1" />

            <path d="M120 160 Q 150 170 180 160" stroke-width="1.5" />

            <circle cx="130" cy="155" r="2.5" fill="currentColor" />
            <circle cx="170" cy="155" r="2.5" fill="currentColor" />

            <path d="M120 148 Q 130 144 140 150" stroke-width="2" />
            <path d="M160 150 Q 170 144 180 148" stroke-width="2" />

            <path
              d="M110 165 Q 90 220 130 310 Q 150 330 170 310 Q 210 220 190 165"
              stroke-width="2"
              fill="none"
            />

            <path d="M130 175 C 120 220, 135 260, 145 305" stroke-width="1.2" />
            <path d="M170 175 C 180 220, 165 260, 155 305" stroke-width="1.2" />
            <path
              d="M150 175 V 315"
              stroke-width="1.5"
              stroke-dasharray="6 3"
            />
            <path d="M138 200 C 130 240, 142 270, 148 295" stroke-width="1" />
            <path d="M162 200 C 170 240, 158 270, 152 295" stroke-width="1" />

            <path d="M225 80 V 330" stroke-width="3" stroke-linecap="round" />

            <polygon
              points="225,60 232,72 225,84 218,72"
              stroke-width="1.5"
              fill="none"
            />
            <circle cx="225" cy="72" r="2" fill="#C45533" stroke="none" />

            <path
              d="M75 220 C 50 260, 40 330, 40 330 H 260 C 260 330, 250 260, 225 220"
              stroke-width="2"
              fill="none"
            />
            <path
              d="M95 230 C 80 270, 70 330, 70 330"
              stroke-width="1"
              stroke-dasharray="4 3"
            />
            <path
              d="M205 230 C 220 270, 230 330, 230 330"
              stroke-width="1"
              stroke-dasharray="4 3"
            />

            <circle cx="70" cy="90" r="3" stroke-width="1" />
            <circle cx="240" cy="190" r="2" stroke-width="1" />
            <path
              d="M 70 90 L 85 110"
              stroke-width="0.8"
              stroke-dasharray="2 2"
            />
          </svg>
        </div>

        <div class="pt-4 border-t border-black/10 dark:border-white/10 text-center font-serif-editorial italic text-sm text-black/70 dark:text-white/70">
          "Somewhere between cloud infrastructure and Middle-earth."
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-6 pt-8 border-t border-black/10 dark:border-white/10 font-mono-tech text-xs">
    <div>
      <span class="text-black/60 dark:text-white/60 block">
        UPTIME PHILOSOPHY
      </span>
      <span class="font-semibold text-sm">99.999% DETERMINISM</span>
    </div>
    <div>
      <span class="text-black/60 dark:text-white/60 block">CORE ENGINE</span>
      <span class="font-semibold text-sm">KUBERNETES & IAC</span>
    </div>
    <div>
      <span class="text-black/60 dark:text-white/60 block">PARADIGM</span>
      <span class="font-semibold text-sm">IMMUTABLE DEPLOYMENTS</span>
    </div>
    <div>
      <span class="text-black/60 dark:text-white/60 block">STATUS</span>
      <span class="font-semibold text-sm accent-copy">
        ALL SYSTEMS OPERATIONAL
      </span>
    </div>
  </div>
</section>
