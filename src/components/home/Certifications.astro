---
import { certifications } from '../../data/portfolio';
---

<section id="certifications" class="space-y-12">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-baseline font-mono-tech text-xs uppercase tracking-widest text-black/60 dark:text-white/50 border-b border-black/10 dark:border-white/10 pb-4">
    <h2 class="md:col-span-3">CERTIFICATIONS</h2>
    <div class="md:col-span-9">CREDENTIALS & LEARNING RECORDS</div>
  </div>

  <div class="space-y-6">
    {certifications.map((certification) => (
      <article class="border border-black/10 dark:border-white/10 bg-[#EFECE6]/70 dark:bg-[#181816]/80 p-6">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
          <div class="space-y-2">
            <div class="font-mono-tech text-[11px] uppercase tracking-[0.18em] text-black/60 dark:text-white/50">
              {certification.issued}
            </div>
            <h3 class="font-serif-editorial text-2xl md:text-3xl leading-tight">
              {certification.name}
            </h3>
            <p class="text-sm text-black/70 dark:text-white/70">
              {certification.issuer}
              {certification.shortName && (
                <span class="font-mono-tech text-[11px] uppercase tracking-[0.14em] text-black/60 dark:text-white/50 ml-2">
                  {certification.shortName}
                </span>
              )}
            </p>
          </div>
          {certification.credentialId && (
            <div class="font-mono-tech text-[11px] uppercase tracking-[0.14em] text-black/60 dark:text-white/50">
              ID: {certification.credentialId}
            </div>
          )}
        </div>

        {certification.verificationUrl && (
          <div class="mt-5">
            <a
              href={certification.verificationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 font-mono-tech text-[11px] uppercase tracking-[0.18em] accent-copy transition-colors"
            >
              Verify credential
            </a>
          </div>
        )}
      </article>
    ))}
  </div>
</section>
