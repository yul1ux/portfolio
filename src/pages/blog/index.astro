---
import { getCollection } from 'astro:content';
import BlogCard from '../../components/blog/BlogCard.astro';
import Header from '../../components/home/Header.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPublishedPosts } from '../../utils/blog';

const posts = getPublishedPosts(await getCollection('blog'));
---

<SiteLayout
  title="Logs | SOE THIHA — CLOUD ENGINEER"
  description="Technical logs by Soe Thiha."
>
  <Header showTerminal={false} />
  <main id="main-content" class="mx-auto min-h-screen max-w-5xl px-6 pb-16 pt-28">
    <header class="mb-12 border-b border-black/10 pb-6 dark:border-white/10">
      <p class="font-mono-tech text-xs uppercase tracking-widest text-black/60 dark:text-white/50">
        SOE THIHA / LOGS
      </p>
      <h1 class="mt-4 font-serif-editorial text-5xl">Technical Logs</h1>
    </header>
    <div>
      {posts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  </main>
</SiteLayout>
